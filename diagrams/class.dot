digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.5];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
p [label="{Product|- id String\l- name String\l- price double\l|+ Product(String, String, double)\l+ getId() String\l+ getName() String\l+ getPrice() double\l}"];
e [label="{«record» Employee|- id String\l- fullName String\l|+ Employee(String, String)\l}"];
oi [label="{OrderItem|+ MAX_QUANTITY = 25 int\l- product Product\l- quantity int\l|+ OrderItem(Product, int)\l- setQuantity(int) void\l~ increase(int) void\l+ getProduct() Product\l+ getQuantity() int\l+ getLineTotal() double\l}"];
o [label="{Order|- employee Employee\l- items List[OrderItem]\l- status OrderStatus\l|+ addProduct(Product, int) void\l+ removeProduct(String) void\l+ total() double\l+ confirm() void\l+ getItems() List[OrderItem]\l+ getEmployee() Employee\l+ getStatus() OrderStatus\l- findItem(String) OrderItem\l- checkDraft() void\l}"];
st [label="{«enum» OrderStatus|DRAFT\lCONFIRMED\l}"];
s [label="{OrderService||+ createOrder(Employee) Order\l+ validateForConfirm(Order) void\l+ confirm(Order) void\l}"];
o -> e [label="1",arrowtail=odiamond,dir=both];
o -> oi [label="1..*",arrowtail=diamond,dir=both];
oi -> p [label="1",arrowtail=odiamond,dir=both];
o -> st [label="статус",style=dashed,arrowhead=open];
s -> o [label="uses",style=dashed,arrowhead=open];
}
