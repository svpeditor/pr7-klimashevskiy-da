digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Создать заказ сотрудника (статус DRAFT)" ];
n2 [label="Получить товар и количество" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n3 [label="A1 Проверить товар (id и наименование не пустые, цена > 0)\nи количество от 1 до 25" ];
n4 [label="Позиция корректна" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
nerr [label="Сообщить об ошибке, позицию не добавлять" ];
n5 [label="Товар уже есть в заказе (по id)" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n6a [label="Увеличить количество существующей позиции\n(итог тоже не больше 25)" ];
n6b [label="Добавить новую позицию" ];
n7 [label="Есть еще позиции" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n8 [label="Рассчитать итог: сумма цена * количество\nпо текущим позициям" ];
n9 [label="A2 Подтвердить заказ: заказ не пустой и еще не подтвержден,\nстатус CONFIRMED, дальше изменения запрещены" ];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5 [label="да"];
n4 -> nerr [label="нет"];
nerr -> n7;
n5 -> n6a [label="да"];
n5 -> n6b [label="нет"];
n6a -> n7;
n6b -> n7;
n7 -> n2 [label="да"];
n7 -> n8 [label="нет"];
n8 -> n9;
n9 -> end;
}
